@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
hide methods
top to bottom direction
title Norms Gold Pan — implemented shared PostgreSQL data model
class User {
  +id: UUID {PK}
  +email: String {unique}
  +authSubject: String? {unique}
  +role: UserRole
  +createdAt: DateTime
  +updatedAt: DateTime
}
class FileAsset {
  +id: UUID {PK}
  +ownerId: UUID {FK}
  +storageKey: String {unique}
  +originalName: String
  +mediaType: String
  +sizeBytes: Int
  +purpose: FilePurpose
  +createdAt: DateTime
}
class StudentProfile {
  +userId: UUID {PK, FK}
  +displayName: String
  +major: String
  +concentration: String?
  +year: String
  +about: String
  +photoId: UUID? {FK}
  +resumeId: UUID? {FK}
  +version: Int
  +updatedAt: DateTime
}
class ProfessorProfile {
  +userId: UUID {PK, FK}
  +displayName: String
  +degree: String
  +department: String
  +education: String
  +about: String
  +researchAreas: String[]
  +contactEmail: String?
  +virtualOfficeUrl: String?
  +officeHours: String
  +photoId: UUID? {FK}
  +version: Int
  +updatedAt: DateTime
}
class ResearchArea {
  +id: UUID {PK}
  +name: String {unique}
}
class Opportunity {
  +id: UUID {PK}
  +professorId: UUID {FK}
  +title: String
  +description: String
  +responsibilities: String[]
  +goals: String[]
  +prerequisites: String[]
  +duration: String?
  +hoursMin: Int?
  +hoursMax: Int?
  +deadline: DateTime?
  +status: OpportunityStatus
  +publishedAt: DateTime?
  +createdAt: DateTime
  +updatedAt: DateTime
}
class OpportunityResearchArea {
  +opportunityId: UUID {FK}
  +researchAreaId: UUID {FK}
}
class Application {
  +id: UUID {PK}
  +studentId: UUID {FK}
  +opportunityId: UUID {FK}
  +resumeFileId: UUID? {FK}
  +status: ApplicationStatus
  +denialReason: String?
  +decidedById: UUID? {FK}
  +decidedAt: DateTime?
  +appliedAt: DateTime
}
class Conversation {
  +lastMessageAt: DateTime
  +id: UUID {PK}
  +studentId: UUID {FK}
  +professorId: UUID {FK}
  +createdAt: DateTime
}
class Message {
  +clientMessageId: UUID?
  +id: UUID {PK}
  +conversationId: UUID {FK}
  +senderId: UUID {FK}
  +body: String
  +sentAt: DateTime
}
enum UserRole {
  STUDENT
  PROFESSOR
}
enum FilePurpose {
  PHOTO
  RESUME
}
enum OpportunityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}
FileAsset "0..*" --> "1" User : owner
StudentProfile "0..1" --> "1" User : user
StudentProfile "0..1" --> "0..1" FileAsset : photo
StudentProfile "0..1" --> "0..1" FileAsset : resume
ProfessorProfile "0..1" --> "1" User : user
ProfessorProfile "0..1" --> "0..1" FileAsset : photo
Opportunity "0..*" --> "1" ProfessorProfile : professor
OpportunityResearchArea "0..*" --> "1" Opportunity : opportunity
OpportunityResearchArea "0..*" --> "1" ResearchArea : researchArea
Application "0..*" --> "1" StudentProfile : student
Application "0..*" --> "1" Opportunity : opportunity
Application "0..*" --> "0..1" FileAsset : resume
Application "0..*" --> "0..1" User : decidedBy
Conversation "0..*" --> "1" StudentProfile : student
Conversation "0..*" --> "1" ProfessorProfile : professor
Message "0..*" --> "1" Conversation : conversation
Message "0..*" --> "1" User : sender
note as Constraints
SQL migrations additionally enforce roles, file purposes/ownership,
publication completeness, unique applications, denial reasons,
immutable message senders, and profile version increments.
Account authentication and object-storage bytes are external.
OpportunityResearchArea has a composite primary key.
Application and Conversation have composite unique pairs.
Message has a unique sender/clientMessageId retry key.
end note
@enduml
